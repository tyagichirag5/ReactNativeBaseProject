{
  "name": "ReactNativeBaseProject",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "build:ios": "npx react-native bundle --dev false --platform ios --entry-file index.js --bundle-output ios/main.jsbundle --assets-dest ios --sourcemap-output ios/main.jsbundle.map",
    "build:release": "npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/ --sourcemap-output index.android.bundle-plain.map && rm -rf ./android/app/src/main/res/drawable-*/ && rm -rf ./android/app/src/main/res/raw/",
    "clean:server": "adb kill-server && adb start-server",
    "debugapk": "cd android && ./gradlew assembleDebug",
    "debugRelease": "cd android && ./gradlew app:assembleRelease",
    "clean": "cd android && ./gradlew clean",
    "cacheClean": "npm cache clean --force",
    "build:a": "npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/",
    "pod": "cd ios && pod install && cd ..",
    "upload-sourcemaps-ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle --sourcemap-output ios/main.jsbundle.map",
    "upload-sourcemaps-android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/build/generated/assets/react/release/index.android.bundle --sourcemap-output android/app/build/generated/sourcemaps/react/release/index.android.bundle.map",
    "sonar": "sonar-scanner -X",
    "sonar:start": "brew services start sonarqube",
    "sonar:stop": "brew services stop sonarqube",
    "sonar:restart": "brew services restart sonarqube",
    "sonar:status": "brew services status sonarqube",
    "sonar:open": "open http://localhost:9000"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.87.1",
    "axios": "^1.20.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
